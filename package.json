{
  "name": "mastra-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Local playground for building AI agents with Mastra (https://mastra.ai), powered by the NaN (nan.builders) OpenAI-compatible gateway",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "mastra dev",
    "dev:portless": "MASTRA_AUTO_DETECT_URL=true portless run",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit && pnpm lessons:check",
    "lessons": "tsx scripts/lesson.ts --list",
    "lesson": "tsx scripts/lesson.ts",
    "lessons:check": "tsx scripts/check-lessons.ts",
    "doctor": "tsx scripts/doctor.ts",
    "rag": "tsx scripts/rag.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.78",
    "@mastra/client-js": "1.57.0",
    "@mastra/core": "^1.79.0",
    "@mastra/duckdb": "1.15.0",
    "@mastra/editor": "^0.16.4",
    "@mastra/evals": "1.10.9",
    "@mastra/libsql": "^1.27.0",
    "@mastra/mcp": "^2.5.0",
    "@mastra/memory": "^1.39.0",
    "@mastra/observability": "1.21.0",
    "@mastra/rag": "^2.7.0",
    "ai": "^7.0.153",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.12.0",
    "@types/node": "^24.19.2",
    "mastra": "^1.35.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0"
}
