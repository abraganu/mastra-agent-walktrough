# Copy this file to .env and fill in your key.
#
# NaN gateway (nan.builders) — OpenAI-compatible endpoint.
# src/mastra/shared/models.ts points an @ai-sdk/openai-compatible provider at
# these two vars (Chat Completions, not the Responses API), e.g.:
#   deepseek-v4-flash   3B tok/mo · function calling · 1M ctx (default here)
#   glm5.3-flash        2B tok/mo · function calling · 1M ctx
#   mimo-v2.6-flash     1B tok/mo · function calling · omnimodal
#   qwen3-embedding     embedding model (4096 dims) for RAG via API
#
# NOTE: prefer models with standard function calling for agents with tools.
# qwen*/gemma* models use XML-style tool calling, which Mastra agents don't
# speak. glm5.3 (non-flash) requires a premium-tier key.
OPENAI_API_KEY=your-nan-api-key-here
OPENAI_BASE_URL=https://api.nan.builders/v1
